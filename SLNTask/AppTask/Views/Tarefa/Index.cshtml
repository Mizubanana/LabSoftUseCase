@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a href="/Tarefa/Create" class="btn btn-success text-white">Novo</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataPlanejada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataIniciada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataFinalizada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataCancelada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StatusTarefa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Prazo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Funcionario)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Descricao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataPlanejada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataIniciada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataFinalizada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataCancelada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StatusTarefa)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Prazo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Funcionario.Nome)
                </td>
                <td>
                    <a href="/Tarefa/Edit/@item.Codigo" class="btn btn-primary btn-sm">Alterar</a>
                    <a href="/Tarefa/Details/@item.Codigo" class="btn btn-success btn-sm">Detalhe</a>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Codigo"
                            data-descricao="@item.Descricao">
                        Excluir
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmação de Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir a tarefa: <strong id="tarefaDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var id = button.getAttribute('data-id');
            var descricao = button.getAttribute('data-descricao');

            var modalDescricao = deleteModal.querySelector('#tarefaDescricao');
            modalDescricao.textContent = descricao;

            var deleteForm = deleteModal.querySelector('#deleteForm');
            deleteForm.action = '/Tarefa/Delete/' + id;
        });
    </script>
}